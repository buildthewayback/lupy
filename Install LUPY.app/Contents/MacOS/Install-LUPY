#!/bin/bash
# Install LUPY — the double-click installer. No Terminal, ever: every word to
# the founder goes through native macOS windows.
#
# What it does, in order:
#   welcome -> find the kit (beside us / search the download places / ask the
#   founder to point — macOS runs fresh downloads from a hidden copy, so
#   "beside us" alone once lost the kit on a real machine) -> SIX NAMED STEPS
#   shown the whole way by the Setup window (LupyProgress.swift, compiled here
#   by the same tools): Check this Mac → Apple's free tools → Download one
#   small library → Compile LUPY → Install into Applications → Launch & prove
#   he's alive (this installer verifies its own work and only then says done).
#
# Founder law, from three field runs on his Mac:
#   · VISIBLE ALWAYS (3.0/3.1 "disappeared"): a standard window he can
#     minimize, with the % on its Dock icon — never glued on top, never gone.
#   · NO PASSWORD POPUPS (3.2 froze 33 min, then died, on keychain asks):
#     build-no-xcode.sh silences git + SwiftPM credential lookups — every
#     download here is public.
#   · PROOF, NOT CLAIMS: step 6 checks the app, its icon, and that he is
#     actually running; the window ends as a checklist he can screenshot,
#     with a plain-words report file for whatever failed.
# If the compiled window cannot be built or dies, self-refreshing dialogues
# carry the same information. There is no silent stretch left anywhere.
# Logs: /tmp/lupy-install.log (everything) · /tmp/lupy-install-report.txt
# The Terminal twin of this installer is "Install LUPY.command" (kept as backup).

# NOTE: no `set -e` — an abrupt exit would leave the founder staring at nothing.
set -u
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:$PATH"

# ── where am I?  …/Install LUPY.app/Contents/MacOS/Install-LUPY ─────────────
SELF_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
APP_BUNDLE="$(cd "$SELF_DIR/../.." 2>/dev/null && pwd)"
KIT="$(dirname "$APP_BUNDLE")"
ICON="$APP_BUNDLE/Contents/Resources/AppIcon.icns"
LOG="/tmp/lupy-install.log"
REPORT_FILE="/tmp/lupy-install-report.txt"
STATUS_DIR="$(mktemp -d /tmp/lupy-install.XXXXXX 2>/dev/null || echo /tmp/lupy-install-status)"
mkdir -p "$STATUS_DIR"
FACE_STATUS_FILE="$STATUS_DIR/face-status.txt"     # v3 line for the window (this script is its only writer)
BUILD_STATUS_FILE="$STATUS_DIR/build-status.txt"   # PCT|STAGE|DETAIL milestones from build-no-xcode.sh
DONE_FILE="$STATUS_DIR/done"
CANCEL_FILE="$STATUS_DIR/cancel"
HEART_FILE="$STATUS_DIR/heartbeat"
RESULT_FILE="$STATUS_DIR/result.txt"

# Kit roots and test modes. The packaged installer carries LupyKit.zip inside
# its own Resources; a repository copy has no payload and uses the kit beside
# it. KIT_URL is the last automatic recovery if this app is ever separated.
KIT_INITIAL_GUESS="$KIT"
KIT_ORIGIN="unresolved"
KIT_CANDIDATE=""
KIT_PAYLOAD="$APP_BUNDLE/Contents/Resources/LupyKit.zip"
KIT_PAYLOAD_SHA256="$APP_BUNDLE/Contents/Resources/LupyKit.sha256"
KIT_URL="${LUPY_KIT_URL:-https://github.com/buildthewayback/lupy/archive/refs/tags/lupy3-final.zip}"
# Extract and build under macOS's per-user temporary root, never inside the
# folder the app happened to be launched from. TMPDIR is absolute, private to
# this user, and avoids fragile build paths inherited from a download folder.
KIT_CACHE_DIR="${TMPDIR:-/tmp}/app.lupy.installer-$UID"
KIT_CACHE_DIR="${KIT_CACHE_DIR%/}"
INSTALLER_NONINTERACTIVE="${LUPY_INSTALLER_NONINTERACTIVE:-0}"
INSTALLER_NO_FACE="${LUPY_INSTALLER_NO_FACE:-0}"
SELF_TEST_KIT=0
case "${1:-}" in
  --self-test-kit) SELF_TEST_KIT=1 ;;
esac

# Keep a handle on the caller's stdout for --self-test-kit before all normal
# installer chatter is redirected into the log.
exec 3>&1
: > "$LOG"
exec >>"$LOG" 2>&1
echo "== Install LUPY (3.4) — $(date) — initial kit guess: $KIT"

cleanup() {
  touch "$DONE_FILE" 2>/dev/null
  sleep 1
  rm -rf "$STATUS_DIR" 2>/dev/null
}
trap cleanup EXIT

# ── native dialogues (osascript; text travels as argv, never string-spliced) ─
dialog() {
  # $1 text · $2 buttons (comma-separated) · $3 default button → echoes the choice
  if [ "$INSTALLER_NONINTERACTIVE" = "1" ]; then printf '%s\n' "$3"; return 0; fi
  /usr/bin/osascript - "$1" "$2" "$3" "$ICON" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set theText to item 1 of argv
  set btns to item 2 of argv
  set defBtn to item 3 of argv
  set iconPath to item 4 of argv
  set AppleScript's text item delimiters to ","
  set btnList to text items of btns
  set AppleScript's text item delimiters to ""
  try
    set r to display dialog theText buttons btnList default button defBtn with title "Install LUPY" with icon (POSIX file iconPath)
  on error errMsg number errNum
    if errNum is -128 then return ""
    set r to display dialog theText buttons btnList default button defBtn with title "Install LUPY"
  end try
  return button returned of r
end run
APPLESCRIPT
}

modal() {
  if [ "$INSTALLER_NONINTERACTIVE" = "1" ]; then sleep 1; printf '%s\n' "$3"; return 0; fi
  # Like dialog(), but gives up after $4 seconds and echoes "" — the building
  # block of every self-refreshing fallback window, so a long wait is always a
  # visible window with fresh numbers, never a vanished installer.
  # $1 text · $2 buttons · $3 default · $4 give-up seconds
  /usr/bin/osascript - "$1" "$2" "$3" "$4" "$ICON" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set theText to item 1 of argv
  set AppleScript's text item delimiters to ","
  set btnList to text items of (item 2 of argv)
  set AppleScript's text item delimiters to ""
  set defBtn to item 3 of argv
  set giveUp to (item 4 of argv) as integer
  set iconPath to item 5 of argv
  try
    set r to display dialog theText buttons btnList default button defBtn with title "Install LUPY" with icon (POSIX file iconPath) giving up after giveUp
  on error errMsg number errNum
    if errNum is -128 then return ""
    set r to display dialog theText buttons btnList default button defBtn with title "Install LUPY" giving up after giveUp
  end try
  if gave up of r then return ""
  return button returned of r
end run
APPLESCRIPT
}

sorry() {
  # $1 text — a one-way explanation, then a clean exit
  dialog "$1" "OK" "OK" >/dev/null
  exit 0
}

cancelled() { [ -f "$CANCEL_FILE" ]; }
elapsed_txt() { # $1 = start epoch → "N min S sec"
  local s=$(( $(date +%s) - $1 ))
  printf '%s min %s sec' $(( s / 60 )) $(( s % 60 ))
}
fmt_dur() { # $1 = seconds → "M:SS" or "-"
  case "$1" in (*[!0-9]*|'') printf '-'; return 0 ;; esac
  [ "$1" -ge 0 ] 2>/dev/null || { printf '-'; return 0; }
  printf '%s:%02d' $(( $1 / 60 )) $(( $1 % 60 ))
}

# ── step machine (harness-extracted by tools/ui/installer-harness.sh) ───────
# Six steps, one line for the window: 3|<overallPct>|<......>|<flags>|<detail>
# Each step char: . waiting · > doing · + done · ! failed · - stopped.
STEP_COUNT=6
STEP_NAMES="Check this Mac|Apple's free tools|Download one small library|Compile LUPY|Install into Applications|Launch & prove he's alive"
STEP_STATES="......"
OVERALL_PCT=0
STUCK_FLAG=""
LAST_DETAIL=""
STEP_STARTED="0 0 0 0 0 0"
STEP_ENDED="0 0 0 0 0 0"
LAST_LOG_SIZE=-1
LAST_LOG_GROWTH=0
BUILD_STARTED=0
STALL_AFTER=150

field_get() { printf '%s' "$1" | cut -d' ' -f"$2"; }
field_set() { # $1 list · $2 idx · $3 value → echoes the new list
  local list="$1" idx="$2" val="$3" out="" i=1 tok
  for tok in $list; do
    if [ "$i" -eq "$idx" ]; then out="$out$val "; else out="$out$tok "; fi
    i=$((i + 1))
  done
  printf '%s' "${out% }"
}
step_name() { printf '%s' "$STEP_NAMES" | cut -d'|' -f"$1"; }
step_set() { # $1 idx (1-based) · $2 state char
  local i=$(( $1 - 1 )) t cur
  cur="$(step_state "$1")"
  # states never travel backwards: a finished step stays finished
  case "$cur" in
    '+') [ "$2" = "+" ] || return 0 ;;
    '!') [ "$2" = "!" ] || return 0 ;;
  esac
  t=$(date +%s)
  if [ "$2" = ">" ] && [ "$(field_get "$STEP_STARTED" "$1")" = "0" ]; then
    STEP_STARTED="$(field_set "$STEP_STARTED" "$1" "$t")"
  fi
  if [ "$2" = "+" ] || [ "$2" = "!" ] || [ "$2" = "-" ]; then
    STEP_ENDED="$(field_set "$STEP_ENDED" "$1" "$t")"
  fi
  STEP_STATES="${STEP_STATES:0:$i}$2${STEP_STATES:$((i + 1))}"
}
step_state() { # $1 idx → its char
  local s="$STEP_STATES" i=1
  while [ $i -lt "$1" ]; do s="${s#?}"; i=$((i + 1)); done
  printf '%s' "${s:0:1}"
}
active_step() { # → 1-based index of '>' or 0
  local i=1 rest="$STEP_STATES"
  while [ $i -le $STEP_COUNT ]; do
    case "$rest" in ('>'*) printf '%s' "$i"; return 0 ;; esac
    rest="${rest#?}"; i=$((i + 1))
  done
  printf '0'
}
compose_face() { # $1 pct (monotonic) · $2 detail → the v3 line the window renders
  case "$1" in (*[!0-9]*|'') : ;; (*) [ "$1" -gt "$OVERALL_PCT" ] 2>/dev/null && OVERALL_PCT="$1" ;; esac
  LAST_DETAIL="$2"
  printf '3|%s|%s|%s|%s\n' "$OVERALL_PCT" "$STEP_STATES" "$STUCK_FLAG" "$2" > "$FACE_STATUS_FILE"
}
refine_and_compose() {
  # Translate the build's milestones + its own output into steps and percent,
  # and raise the STUCK flag when the build's text stops moving (the 33-minute
  # silent freeze behind a hidden password window must never pass unnoticed).
  local LOGF="$KIT/build-noxcode/build.log" mline mpct mdetail line n m pct detail size now bs
  now=$(date +%s)
  mline=""; [ -f "$BUILD_STATUS_FILE" ] && mline="$(head -1 "$BUILD_STATUS_FILE" 2>/dev/null)"
  mpct="$(printf '%s' "$mline" | cut -d'|' -f1)"
  case "$mpct" in (*[!0-9]*|'') mpct=0 ;; esac
  mdetail="$(printf '%s' "$mline" | cut -d'|' -f3)"

  size=0
  if [ -f "$LOGF" ]; then size="$(wc -c < "$LOGF" 2>/dev/null | tr -d ' ')"; fi
  case "$size" in (*[!0-9]*|'') size=0 ;; esac
  if [ "$size" -ne "$LAST_LOG_SIZE" ]; then LAST_LOG_SIZE="$size"; LAST_LOG_GROWTH="$now"; fi

  detail="$mdetail"; pct=10
  if [ "$mpct" -ge 70 ]; then
    step_set 3 '+'; step_set 4 '+'; step_set 5 '>'
    pct="$mpct"
    [ -n "$detail" ] || detail="assembling him…"
  else
    line=""
    [ -f "$LOGF" ] && line="$(grep -E '^\[[0-9]+/[0-9]+\]' "$LOGF" 2>/dev/null | tail -1)"
    if [ -n "$line" ]; then
      bs="$(printf '%s' "$line" | sed -E 's/^\[([0-9]+)\/([0-9]+)\].*/\1 \2/')"
      n="${bs%% *}"; m="${bs##* }"
      case "$n$m" in (*[!0-9]*|'') n=0; m=0 ;; esac
      case "$line" in
        *Downloading*|*Fetching*)
          step_set 3 '>'
          pct=15; [ "$m" -gt 0 ] 2>/dev/null && pct=$(( 15 + (9 * n) / m ))
          if [ "$m" -gt 1000000 ] 2>/dev/null; then
            detail="downloading a ready-made piece — $(( n / 1048576 )) of $(( m / 1048576 )) MB"
          else
            detail="bringing the library home — $n of $m little pieces"
          fi
          ;;
        *)
          step_set 3 '+'; step_set 4 '>'
          pct=25; [ "$m" -gt 0 ] 2>/dev/null && pct=$(( 25 + (43 * n) / m ))
          detail="$n of $m steps · $(printf '%s' "$line" | sed -E 's/^\[[0-9]+\/[0-9]+\] //')"
          ;;
      esac
    elif [ -f "$LOGF" ] && grep -qiE 'fetching|cloning|resolving|downloading' "$LOGF" 2>/dev/null; then
      step_set 3 '>'; pct=12
      detail="bringing the library home (public, needs internet — no password, ever)"
    else
      step_set 3 '>'; pct=10
      [ -n "$detail" ] || detail="warming up the compiler…"
    fi
  fi

  STUCK_FLAG=""
  if [ "$LAST_LOG_GROWTH" -gt 0 ] && [ $(( now - LAST_LOG_GROWTH )) -ge $STALL_AFTER ] \
     && [ $(( now - BUILD_STARTED )) -ge $STALL_AFTER ]; then
    STUCK_FLAG="STUCK"
    detail="No movement for $(( (now - LAST_LOG_GROWTH) / 60 )) min — if a password or permission window is hiding behind other windows, bring it forward. Nothing is lost; LUPY is still waiting."
  fi
  compose_face "$pct" "$detail"
}
# ── end step machine ──────────────────────────────────────────────────────────

step_dur() { # $1 idx → "M:SS" once ended, "-" otherwise
  local a b
  a="$(field_get "$STEP_STARTED" "$1")"; b="$(field_get "$STEP_ENDED" "$1")"
  if [ "$a" != "0" ] && [ "$b" != "0" ]; then fmt_dur $(( b - a )); else printf '-'; fi
}

write_report() { # $1 result word · $2 reason (may be "")
  {
    echo "LUPY install report — $(date)"
    echo "Installer 3.4 · macOS $(sw_vers -productVersion 2>/dev/null) · $(sysctl -n machdep.cpu.brand_string 2>/dev/null || uname -m) · kit: $KIT"
    echo "Result: $1${2:+ — $2}"
    echo
    echo "Steps:"
    local i=1 c word
    while [ $i -le $STEP_COUNT ]; do
      c="$(step_state $i)"
      case "$c" in
        '+') word="OK" ;; '!') word="FAILED" ;; '-') word="stopped" ;;
        '>') word="was doing this" ;; *) word="not reached" ;;
      esac
      printf '  %s. %-28s %-10s (%s)\n' "$i" "$(step_name $i)" "$word" "$(step_dur $i)"
      i=$((i + 1))
    done
    echo
    echo "Proof checks (step 6):"
    printf '%s' "${VERIFY_LINES:-  (not reached)
}"
    echo
    echo "Compile errors (the complete list, so ONE report carries them all):"
    grep -E 'error:' "$KIT/build-noxcode/build.log" 2>/dev/null | head -200 || echo "(no error lines — the build may not have been reached)"
    echo
    echo "Last build lines:"
    tail -60 "$KIT/build-noxcode/build.log" 2>/dev/null || echo "(no build log)"
    echo
    echo "Full install log: $LOG (still on this Mac)"
  } > "$REPORT_FILE"
  echo "report written: $REPORT_FILE"
}

# ── kit resolution (test-extracted) ───────────────────────────────────────────
# The installer must not depend on one lucky folder layout. A double-clicked,
# quarantined app can be translocated away from the folder it arrived in; a kit
# can be direct in Downloads, nested under several folders, on the Desktop, in
# Documents, beside the app, or absent entirely. Resolution order is therefore:
# explicit test/support override → beside this app → verified payload
# embedded in this app → working folder/app ancestors → common download places →
# the official public kit download. The manual folder picker in the main flow
# is the last resort, not the design.
kit_log() { printf '%s\n' "$*" >&2; }

kit_status() {
  # compose_face is defined by the installer before this section; the isolated
  # roots test provides a stub. Guarding keeps the extracted functions safe.
  if command -v compose_face >/dev/null 2>&1; then
    compose_face "${1:-3}" "${2:-}"
  fi
}

looks_like_kit() {
  # Absolute paths only: launch paths and every resolver below produce one.
  # This refuses the "." that dirname "" can produce, and partial folders that
  # merely contain a build script are not treated as a complete kit.
  case "$1" in (/*) ;; (*) return 1 ;; esac
  [ -f "$1/scripts/build-no-xcode.sh" ] &&
    [ -f "$1/Mac/Package.swift" ] &&
    [ -f "$1/LupyCore/Package.swift" ] &&
    [ -d "$1/Mac/Sources" ] &&
    [ -d "$1/Install LUPY.app" ]
}

kit_under() {
  # $1 = a folder that may contain the kit down to seven path levels.
  local f d
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    d="$(dirname "$(dirname "$f")")"
    if looks_like_kit "$d"; then printf '%s\n' "$d"; return 0; fi
  done <<KITFIND
$(find "$1" -maxdepth 7 -type f -name build-no-xcode.sh -path '*/scripts/build-no-xcode.sh' 2>/dev/null | head -40)
KITFIND
  return 1
}

find_kit() {
  # Search the places a browser download can plausibly be unzipped. Newest
  # complete kit wins, so an older clone cannot beat the kit just downloaded.
  local root f d m best="" best_m=0
  for root in "$HOME/Downloads" "$HOME/Desktop" "$HOME/Documents" "$HOME/Applications" "/Applications"; do
    [ -d "$root" ] || continue
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      d="$(dirname "$(dirname "$f")")"
      looks_like_kit "$d" || continue
      m="$(stat -c %Y "$d" 2>/dev/null || stat -f %m "$d" 2>/dev/null || echo 0)"
      case "$m" in (*[!0-9]*|'') m=0 ;; esac
      if [ -z "$best" ] || [ "$m" -gt "$best_m" ]; then best="$d"; best_m="$m"; fi
    done <<KITFIND
$(find "$root" -maxdepth 8 -type f -name build-no-xcode.sh -path '*/scripts/build-no-xcode.sh' 2>/dev/null | head -60)
KITFIND
  done
  [ -n "$best" ] && printf '%s\n' "$best"
}

sha256_file() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" 2>/dev/null | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" 2>/dev/null | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 "$1" 2>/dev/null | awk '{print $NF}'
  fi
}

extract_zip_archive() {
  # ditto is Archive Utility's engine on macOS and preserves executable bits.
  # unzip is only the Linux/CI sandbox fallback for the extracted resolver.
  mkdir -p "$2" || return 1
  if command -v ditto >/dev/null 2>&1; then
    ditto -x -k "$1" "$2"
  elif command -v unzip >/dev/null 2>&1; then
    unzip -q "$1" -d "$2"
  else
    return 1
  fi
}

find_extracted_kit() {
  if looks_like_kit "$1"; then
    printf '%s\n' "$1"
    return 0
  fi
  kit_under "$1"
}

prepare_payload_kit() {
  KIT_CANDIDATE=""
  [ -f "$KIT_PAYLOAD" ] || return 1

  local expected="" actual="" short_hash="" dest="" tmp="" found=""
  kit_status 3 "opening the complete installation kit inside this app…"
  actual="$(sha256_file "$KIT_PAYLOAD")"
  case "$actual" in
    (*[!0-9a-fA-F]*|'') kit_log "payload: could not calculate SHA-256"; return 1 ;;
  esac
  if [ -f "$KIT_PAYLOAD_SHA256" ]; then
    expected="$(awk 'NR == 1 {print $1}' "$KIT_PAYLOAD_SHA256" 2>/dev/null)"
    if [ -z "$expected" ] || [ "$actual" != "$expected" ]; then
      kit_log "payload: SHA-256 mismatch (expected $expected, got $actual)"
      return 1
    fi
  fi

  short_hash="$(printf '%s' "$actual" | cut -c1-16)"
  dest="$KIT_CACHE_DIR/payload-$short_hash"
  if [ -d "$dest" ]; then
    found="$(find_extracted_kit "$dest" 2>/dev/null || true)"
    if [ -n "$found" ]; then
      KIT_CANDIDATE="$found"
      kit_log "payload: verified cached kit at $KIT_CANDIDATE"
      return 0
    fi
  fi

  tmp="$dest.tmp.$$"
  rm -rf "$tmp"
  mkdir -p "$KIT_CACHE_DIR" "$tmp" || return 1
  if ! extract_zip_archive "$KIT_PAYLOAD" "$tmp"; then
    kit_log "payload: extraction failed"
    rm -rf "$tmp"
    return 1
  fi
  found="$(find_extracted_kit "$tmp" 2>/dev/null || true)"
  if [ -z "$found" ]; then
    kit_log "payload: extracted files do not contain a complete kit"
    rm -rf "$tmp"
    return 1
  fi
  rm -rf "$dest"
  mv "$tmp" "$dest" || return 1
  found="$(find_extracted_kit "$dest" 2>/dev/null || true)"
  [ -n "$found" ] || return 1
  KIT_CANDIDATE="$found"
  kit_log "payload: verified embedded kit at $KIT_CANDIDATE"
  return 0
}

prepare_downloaded_kit() {
  KIT_CANDIDATE=""
  [ "${LUPY_INSTALLER_NO_DOWNLOAD:-0}" = "1" ] && return 1
  command -v curl >/dev/null 2>&1 || return 1

  local archive="" partial="" extract_root="" found="" pid="" code=0 size=0 mb=0 choice=""
  mkdir -p "$KIT_CACHE_DIR/downloads" || return 1
  archive="$KIT_CACHE_DIR/downloads/lupy-kit-$$.zip"
  partial="$archive.part"
  extract_root="$KIT_CACHE_DIR/downloaded-$$"
  rm -f "$partial"
  rm -rf "$extract_root"
  mkdir -p "$extract_root" || return 1

  kit_status 3 "downloading the complete official installation kit…"
  kit_log "download: fetching official kit from $KIT_URL"
  curl --fail --location --retry 2 --connect-timeout 20 --output "$partial" "$KIT_URL" >/dev/null 2>&1 &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    size=0
    [ -f "$partial" ] && size="$(wc -c < "$partial" 2>/dev/null | tr -d ' ')"
    case "$size" in (*[!0-9]*|'') size=0 ;; esac
    mb=$((size / 1048576))
    kit_status 3 "downloading the complete official installation kit… ${mb} MB so far"
    if [ "${INSTALLER_NONINTERACTIVE:-0}" = "1" ]; then
      sleep 1
    else
      choice="$(modal "Finding the installation files

This copy of Install LUPY is separated from its source kit, so I am downloading the complete official kit myself. Nothing for you to find or move.

Downloaded so far: ${mb} MB." "Keep waiting,Not now" "Keep waiting" 10)"
      if [ "$choice" = "Not now" ]; then
        kill "$pid" 2>/dev/null
        wait "$pid" 2>/dev/null
        rm -f "$partial"
        rm -rf "$extract_root"
        return 1
      fi
    fi
  done
  wait "$pid" 2>/dev/null
  code=$?
  if [ "$code" -ne 0 ] || [ ! -s "$partial" ]; then
    kit_log "download: official kit download failed (curl exit $code)"
    rm -f "$partial"
    rm -rf "$extract_root"
    return 1
  fi
  mv "$partial" "$archive" || return 1

  kit_status 3 "checking the downloaded installation kit…"
  if ! extract_zip_archive "$archive" "$extract_root"; then
    kit_log "download: extraction failed"
    rm -rf "$extract_root"
    return 1
  fi
  found="$(find_extracted_kit "$extract_root" 2>/dev/null || true)"
  if [ -z "$found" ]; then
    kit_log "download: archive did not contain a complete kit"
    rm -rf "$extract_root"
    return 1
  fi
  KIT_CANDIDATE="$found"
  kit_log "download: verified official kit at $KIT_CANDIDATE"
  return 0
}

resolve_kit() {
  local candidate="" found="" ancestor="" depth=0
  KIT_ORIGIN="unresolved"

  if [ -n "${LUPY_KIT_DIR:-}" ]; then
    candidate="${LUPY_KIT_DIR%/}"
    if looks_like_kit "$candidate"; then
      KIT="$candidate"; KIT_ORIGIN="LUPY_KIT_DIR"; return 0
    fi
    found="$(kit_under "$candidate" 2>/dev/null || true)"
    if [ -n "$found" ]; then
      KIT="$found"; KIT_ORIGIN="LUPY_KIT_DIR (nested)"; return 0
    fi
    kit_log "resolve: LUPY_KIT_DIR is not a complete kit: $candidate"
  fi

  if looks_like_kit "$KIT"; then
    KIT_ORIGIN="beside installer"
    return 0
  fi

  if prepare_payload_kit; then
    KIT="$KIT_CANDIDATE"; KIT_ORIGIN="embedded payload"; return 0
  fi

  candidate="$(pwd 2>/dev/null || true)"
  if [ -n "$candidate" ] && looks_like_kit "$candidate"; then
    KIT="$candidate"; KIT_ORIGIN="working folder"; return 0
  fi

  ancestor="$APP_BUNDLE"
  depth=0
  while [ "$depth" -lt 8 ]; do
    ancestor="$(dirname "$ancestor")"
    if looks_like_kit "$ancestor"; then
      KIT="$ancestor"; KIT_ORIGIN="installer ancestor"; return 0
    fi
    [ "$ancestor" = "/" ] && break
    depth=$((depth + 1))
  done

  found="$(find_kit || true)"
  if [ -n "$found" ] && looks_like_kit "$found"; then
    KIT="$found"; KIT_ORIGIN="found in a download place"; return 0
  fi

  if prepare_downloaded_kit; then
    KIT="$KIT_CANDIDATE"; KIT_ORIGIN="official download"; return 0
  fi

  return 1
}
