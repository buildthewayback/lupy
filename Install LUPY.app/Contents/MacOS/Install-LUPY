# ── the face ──────────────────────────────────────────────────────────────────
FACE_PID=""
FACE_CPID=""
face_precompile() {
  [ "$INSTALLER_NO_FACE" = "1" ] && return 0
  # Compile the face NOW, in the background behind the welcome dialog, so the
  # window is ready the moment the founder clicks Install. The old order
  # compiled it after step 2 behind a train of 3-second refreshing popups —
  # the founder's "pop up 3 times then appear big install" (2026-10-22).
  # ONE dialog, then ONE window. Harmless when the tools aren't there yet:
  # face_start retries after Apple's tools step.
  local SRC="$APP_BUNDLE/Contents/Resources/LupyProgress.swift"
  FACE_CPID=""
  [ -f "$SRC" ] || return 0
  command -v swiftc >/dev/null 2>&1 || return 0
  ( swiftc -O -o "$STATUS_DIR/LupyProgress" "$SRC" ) &
  FACE_CPID=$!
}

face_compile_wait() {
  # Wait out a compile behind ONE calm window (20s refresh instead of the
  # old 3s popup flicker). Only seen when the founder clicked through the
  # welcome faster than the compiler.
  local waited=0 M=""
  while kill -0 "$FACE_CPID" 2>/dev/null; do
    M="$(modal "Preparing your installer window…

(a few more seconds — then one window with the six steps stays with you the whole way, and you can minimize it any time)" "Stop" "Stop" 20)"
    if [ "$M" = "Stop" ]; then kill "$FACE_CPID" 2>/dev/null; exit 0; fi
    waited=$((waited + 20))
    [ "$waited" -ge 100 ] && break
  done
  wait "$FACE_CPID" 2>/dev/null
  FACE_CPID=""
}

face_start() {
  [ "$INSTALLER_NO_FACE" = "1" ] && return 0
  # Put the face window up — once. Called after step 1 (the window then
  # carries steps 2–6) and again after Apple's tools for Macs where the
  # compiler only arrived there. Any failure → FACE_PID stays empty and
  # refreshing modals carry the build instead. Never silence.
  [ -n "$FACE_PID" ] && return 0
  local SRC="$APP_BUNDLE/Contents/Resources/LupyProgress.swift" BIN="$STATUS_DIR/LupyProgress"
  [ -f "$SRC" ] || { echo "face: source missing — modal fallback"; return 0; }
  if [ ! -x "$BIN" ]; then
    command -v swiftc >/dev/null 2>&1 || { echo "face: no swiftc yet — retry after Apple's tools"; return 0; }
    if [ -z "$FACE_CPID" ]; then
      echo "face: compiling…"
      ( swiftc -O -o "$BIN" "$SRC" ) &
      FACE_CPID=$!
    fi
    face_compile_wait
  fi
  [ -x "$BIN" ] || { echo "face: compile failed — modal fallback"; return 0; }
  "$BIN" "$FACE_STATUS_FILE" "$DONE_FILE" "$CANCEL_FILE" "$HEART_FILE" \
         "$KIT/build-noxcode/build.log" "$ICON" "$RESULT_FILE" "$REPORT_FILE" >/dev/null 2>&1 &
  FACE_PID=$!
  sleep 1
  if ! kill -0 "$FACE_PID" 2>/dev/null; then
    echo "face: died at launch — modal fallback"
    FACE_PID=""
    return 0
  fi
  echo "face: up (pid $FACE_PID)"
}

# ── step 6: prove he's alive ──────────────────────────────────────────────────
VERIFY_OK=1
VERIFY_LINES=""
VERIFY_REASON=""
verify_install() {
  local APP=/Applications/Lupy.app alive=0 waited=0
  VERIFY_OK=1; VERIFY_LINES=""; VERIFY_REASON=""
  chk() { # $1 label · $2 1=ok 0=bad
    if [ "$2" = "1" ]; then
      VERIFY_LINES="${VERIFY_LINES}  ✓ $1
"
    else
      VERIFY_LINES="${VERIFY_LINES}  ✗ $1
"
      VERIFY_OK=0
      [ -n "$VERIFY_REASON" ] || VERIFY_REASON="$1"
    fi
  }
  if [ -d "$APP" ]; then chk "Lupy.app is in Applications" 1; else chk "Lupy.app is in Applications" 0; fi
  if [ -x "$APP/Contents/MacOS/Lupy" ]; then chk "his program is inside, ready to run" 1; else chk "his program is inside, ready to run" 0; fi
  if [ -f "$APP/Contents/Resources/AppIcon.icns" ]; then chk "his face (app icon) is on" 1; else chk "his face (app icon) is on" 0; fi
  if codesign --verify --deep "$APP" >/dev/null 2>&1; then
    VERIFY_LINES="${VERIFY_LINES}  · signature check: OK (ad-hoc, as expected for a home-built app)
"
  else
    VERIFY_LINES="${VERIFY_LINES}  · signature check: complained (not counted as failure on its own)
"
  fi
  while [ $waited -lt 24 ]; do
    if pgrep -x Lupy >/dev/null 2>&1 || pgrep -f "Lupy.app/Contents/MacOS/Lupy" >/dev/null 2>&1; then alive=1; break; fi
    sleep 2; waited=$((waited + 2))
    touch "$HEART_FILE"
    compose_face 98 "waiting for him to appear under your menu bar… (${waited}s)"
  done
  chk "Lupy is running (the pill under your menu bar)" "$alive"
  printf '%s' "$VERIFY_LINES"
  [ "$VERIFY_OK" = "1" ]
}

