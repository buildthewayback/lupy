#!/bin/bash
# Install LUPY — the double-click installer. No Terminal, ever: every word to
# the founder goes through native macOS windows.
#
# What it does, in order:
#   welcome -> find the kit (beside us / search the download places / ask the
#   founder to point — macOS runs fresh downloads from a hidden copy, so
#   "beside us" alone once lost the kit on a real machine) -> SIX NAMED STEPS
#   shown the whole way by the Setup window (LupyProgress.swift, compiled here
#   by the same tools): Check this Mac → Apple's free tools → Download one
#   small library → Compile LUPY → Install into Applications → Launch & prove
#   he's alive (this installer verifies its own work and only then says done).
#
# Founder law, from three field runs on his Mac:
#   · VISIBLE ALWAYS (3.0/3.1 "disappeared"): a standard window he can
#     minimize, with the % on its Dock icon — never glued on top, never gone.
#   · NO PASSWORD POPUPS (3.2 froze 33 min, then died, on keychain asks):
#     build-no-xcode.sh silences git + SwiftPM credential lookups — every
#     download here is public.
#   · PROOF, NOT CLAIMS: step 6 checks the app, its icon, and that he is
#     actually running; the window ends as a checklist he can screenshot,
#     with a plain-words report file for whatever failed.
# If the compiled window cannot be built or dies, self-refreshing dialogues
# carry the same information. There is no silent stretch left anywhere.
# Logs: /tmp/lupy-install.log (everything) · /tmp/lupy-install-report.txt
# The Terminal twin of this installer is "Install LUPY.command" (kept as backup).

# NOTE: no `set -e` — an abrupt exit would leave the founder staring at nothing.
set -u
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:$PATH"

# ── where am I?  …/Install LUPY.app/Contents/MacOS/Install-LUPY ─────────────
SELF_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
APP_BUNDLE="$(cd "$SELF_DIR/../.." 2>/dev/null && pwd)"
KIT="$(dirname "$APP_BUNDLE")"
ICON="$APP_BUNDLE/Contents/Resources/AppIcon.icns"
LOG="/tmp/lupy-install.log"
REPORT_FILE="/tmp/lupy-install-report.txt"
STATUS_DIR="$(mktemp -d /tmp/lupy-install.XXXXXX 2>/dev/null || echo /tmp/lupy-install-status)"
mkdir -p "$STATUS_DIR"
FACE_STATUS_FILE="$STATUS_DIR/face-status.txt"     # v3 line for the window (this script is its only writer)
BUILD_STATUS_FILE="$STATUS_DIR/build-status.txt"   # PCT|STAGE|DETAIL milestones from build-no-xcode.sh
DONE_FILE="$STATUS_DIR/done"
CANCEL_FILE="$STATUS_DIR/cancel"
HEART_FILE="$STATUS_DIR/heartbeat"
RESULT_FILE="$STATUS_DIR/result.txt"

: > "$LOG"
exec >>"$LOG" 2>&1
echo "== Install LUPY (3.3) — $(date) — kit: $KIT"

cleanup() {
  touch "$DONE_FILE" 2>/dev/null
  sleep 1
  rm -rf "$STATUS_DIR" 2>/dev/null
}
trap cleanup EXIT

# ── native dialogues (osascript; text travels as argv, never string-spliced) ─
dialog() {
  # $1 text · $2 buttons (comma-separated) · $3 default button → echoes the choice
  /usr/bin/osascript - "$1" "$2" "$3" "$ICON" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set theText to item 1 of argv
  set btns to item 2 of argv
  set defBtn to item 3 of argv
  set iconPath to item 4 of argv
  set AppleScript's text item delimiters to ","
  set btnList to text items of btns
  set AppleScript's text item delimiters to ""
  try
    set r to display dialog theText buttons btnList default button defBtn with title "Install LUPY" with icon (POSIX file iconPath)
  on error errMsg number errNum
    if errNum is -128 then return ""
    set r to display dialog theText buttons btnList default button defBtn with title "Install LUPY"
  end try
  return button returned of r
end run
APPLESCRIPT
}

modal() {
  # Like dialog(), but gives up after $4 seconds and echoes "" — the building
  # block of every self-refreshing fallback window, so a long wait is always a
  # visible window with fresh numbers, never a vanished installer.
  # $1 text · $2 buttons · $3 default · $4 give-up seconds
  /usr/bin/osascript - "$1" "$2" "$3" "$4" "$ICON" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set theText to item 1 of argv
  set AppleScript's text item delimiters to ","
  set btnList to text items of (item 2 of argv)
  set AppleScript's text item delimiters to ""
  set defBtn to item 3 of argv
  set giveUp to (item 4 of argv) as integer
  set iconPath to item 5 of argv
  try
    set r to display dialog theText buttons btnList default button defBtn with title "Install LUPY" with icon (POSIX file iconPath) giving up after giveUp
  on error errMsg number errNum
    if errNum is -128 then return ""
    set r to display dialog theText buttons btnList default button defBtn with title "Install LUPY" giving up after giveUp
  end try
  if gave up of r then return ""
  return button returned of r
end run
APPLESCRIPT
}

sorry() {
  # $1 text — a one-way explanation, then a clean exit
  dialog "$1" "OK" "OK" >/dev/null
  exit 0
}

cancelled() { [ -f "$CANCEL_FILE" ]; }
elapsed_txt() { # $1 = start epoch → "N min S sec"
  local s=$(( $(date +%s) - $1 ))
  printf '%s min %s sec' $(( s / 60 )) $(( s % 60 ))
}
fmt_dur() { # $1 = seconds → "M:SS" or "-"
  case "$1" in (*[!0-9]*|'') printf '-'; return 0 ;; esac
  [ "$1" -ge 0 ] 2>/dev/null || { printf '-'; return 0; }
  printf '%s:%02d' $(( $1 / 60 )) $(( $1 % 60 ))
}

# ── step machine (harness-extracted by tools/ui/installer-harness.sh) ───────
# Six steps, one line for the window: 3|<overallPct>|<......>|<flags>|<detail>
# Each step char: . waiting · > doing · + done · ! failed · - stopped.
STEP_COUNT=6
STEP_NAMES="Check this Mac|Apple's free tools|Download one small library|Compile LUPY|Install into Applications|Launch & prove he's alive"
STEP_STATES="......"
OVERALL_PCT=0
STUCK_FLAG=""
LAST_DETAIL=""
STEP_STARTED="0 0 0 0 0 0"
STEP_ENDED="0 0 0 0 0 0"
LAST_LOG_SIZE=-1
LAST_LOG_GROWTH=0
BUILD_STARTED=0
STALL_AFTER=150

field_get() { printf '%s' "$1" | cut -d' ' -f"$2"; }
field_set() { # $1 list · $2 idx · $3 value → echoes the new list
  local list="$1" idx="$2" val="$3" out="" i=1 tok
  for tok in $list; do
    if [ "$i" -eq "$idx" ]; then out="$out$val "; else out="$out$tok "; fi
    i=$((i + 1))
  done
  printf '%s' "${out% }"
}
step_name() { printf '%s' "$STEP_NAMES" | cut -d'|' -f"$1"; }
step_set() { # $1 idx (1-based) · $2 state char
  local i=$(( $1 - 1 )) t cur
  cur="$(step_state "$1")"
  # states never travel backwards: a finished step stays finished
  case "$cur" in
    '+') [ "$2" = "+" ] || return 0 ;;
    '!') [ "$2" = "!" ] || return 0 ;;
  esac
  t=$(date +%s)
  if [ "$2" = ">" ] && [ "$(field_get "$STEP_STARTED" "$1")" = "0" ]; then
    STEP_STARTED="$(field_set "$STEP_STARTED" "$1" "$t")"
  fi
  if [ "$2" = "+" ] || [ "$2" = "!" ] || [ "$2" = "-" ]; then
    STEP_ENDED="$(field_set "$STEP_ENDED" "$1" "$t")"
  fi
  STEP_STATES="${STEP_STATES:0:$i}$2${STEP_STATES:$((i + 1))}"
}
step_state() { # $1 idx → its char
  local s="$STEP_STATES" i=1
  while [ $i -lt "$1" ]; do s="${s#?}"; i=$((i + 1)); done
  printf '%s' "${s:0:1}"
}
active_step() { # → 1-based index of '>' or 0
  local i=1 rest="$STEP_STATES"
  while [ $i -le $STEP_COUNT ]; do
    case "$rest" in ('>'*) printf '%s' "$i"; return 0 ;; esac
    rest="${rest#?}"; i=$((i + 1))
  done
  printf '0'
}
compose_face() { # $1 pct (monotonic) · $2 detail → the v3 line the window renders
  case "$1" in (*[!0-9]*|'') : ;; (*) [ "$1" -gt "$OVERALL_PCT" ] 2>/dev/null && OVERALL_PCT="$1" ;; esac
  LAST_DETAIL="$2"
  printf '3|%s|%s|%s|%s\n' "$OVERALL_PCT" "$STEP_STATES" "$STUCK_FLAG" "$2" > "$FACE_STATUS_FILE"
}
refine_and_compose() {
  # Translate the build's milestones + its own output into steps and percent,
  # and raise the STUCK flag when the build's text stops moving (the 33-minute
  # silent freeze behind a hidden password window must never pass unnoticed).
  local LOGF="$KIT/build-noxcode/build.log" mline mpct mdetail line n m pct detail size now bs
  now=$(date +%s)
  mline=""; [ -f "$BUILD_STATUS_FILE" ] && mline="$(head -1 "$BUILD_STATUS_FILE" 2>/dev/null)"
  mpct="$(printf '%s' "$mline" | cut -d'|' -f1)"
  case "$mpct" in (*[!0-9]*|'') mpct=0 ;; esac
  mdetail="$(printf '%s' "$mline" | cut -d'|' -f3)"

  size=0
  if [ -f "$LOGF" ]; then size="$(wc -c < "$LOGF" 2>/dev/null | tr -d ' ')"; fi
  case "$size" in (*[!0-9]*|'') size=0 ;; esac
  if [ "$size" -ne "$LAST_LOG_SIZE" ]; then LAST_LOG_SIZE="$size"; LAST_LOG_GROWTH="$now"; fi

  detail="$mdetail"; pct=10
  if [ "$mpct" -ge 70 ]; then
    step_set 3 '+'; step_set 4 '+'; step_set 5 '>'
    pct="$mpct"
    [ -n "$detail" ] || detail="assembling him…"
  else
    line=""
    [ -f "$LOGF" ] && line="$(grep -E '^\[[0-9]+/[0-9]+\]' "$LOGF" 2>/dev/null | tail -1)"
    if [ -n "$line" ]; then
      bs="$(printf '%s' "$line" | sed -E 's/^\[([0-9]+)\/([0-9]+)\].*/\1 \2/')"
      n="${bs%% *}"; m="${bs##* }"
      case "$n$m" in (*[!0-9]*|'') n=0; m=0 ;; esac
      case "$line" in
        *Downloading*|*Fetching*)
          step_set 3 '>'
          pct=15; [ "$m" -gt 0 ] 2>/dev/null && pct=$(( 15 + (9 * n) / m ))
          if [ "$m" -gt 1000000 ] 2>/dev/null; then
            detail="downloading a ready-made piece — $(( n / 1048576 )) of $(( m / 1048576 )) MB"
          else
            detail="bringing the library home — $n of $m little pieces"
          fi
          ;;
        *)
          step_set 3 '+'; step_set 4 '>'
          pct=25; [ "$m" -gt 0 ] 2>/dev/null && pct=$(( 25 + (43 * n) / m ))
          detail="$n of $m steps · $(printf '%s' "$line" | sed -E 's/^\[[0-9]+\/[0-9]+\] //')"
          ;;
      esac
    elif [ -f "$LOGF" ] && grep -qiE 'fetching|cloning|resolving|downloading' "$LOGF" 2>/dev/null; then
      step_set 3 '>'; pct=12
      detail="bringing the library home (public, needs internet — no password, ever)"
    else
      step_set 3 '>'; pct=10
      [ -n "$detail" ] || detail="warming up the compiler…"
    fi
  fi

  STUCK_FLAG=""
  if [ "$LAST_LOG_GROWTH" -gt 0 ] && [ $(( now - LAST_LOG_GROWTH )) -ge $STALL_AFTER ] \
     && [ $(( now - BUILD_STARTED )) -ge $STALL_AFTER ]; then
    STUCK_FLAG="STUCK"
    detail="No movement for $(( (now - LAST_LOG_GROWTH) / 60 )) min — if a password or permission window is hiding behind other windows, bring it forward. Nothing is lost; LUPY is still waiting."
  fi
  compose_face "$pct" "$detail"
}
# ── end step machine ──────────────────────────────────────────────────────────

step_dur() { # $1 idx → "M:SS" once ended, "-" otherwise
  local a b
  a="$(field_get "$STEP_STARTED" "$1")"; b="$(field_get "$STEP_ENDED" "$1")"
  if [ "$a" != "0" ] && [ "$b" != "0" ]; then fmt_dur $(( b - a )); else printf '-'; fi
}

write_report() { # $1 result word · $2 reason (may be "")
  {
    echo "LUPY install report — $(date)"
    echo "Installer 3.3 · macOS $(sw_vers -productVersion 2>/dev/null) · $(sysctl -n machdep.cpu.brand_string 2>/dev/null || uname -m) · kit: $KIT"
    echo "Result: $1${2:+ — $2}"
    echo
    echo "Steps:"
    local i=1 c word
    while [ $i -le $STEP_COUNT ]; do
      c="$(step_state $i)"
      case "$c" in
        '+') word="OK" ;; '!') word="FAILED" ;; '-') word="stopped" ;;
        '>') word="was doing this" ;; *) word="not reached" ;;
      esac
      printf '  %s. %-28s %-10s (%s)\n' "$i" "$(step_name $i)" "$word" "$(step_dur $i)"
      i=$((i + 1))
    done
    echo
    echo "Proof checks (step 6):"
    printf '%s' "${VERIFY_LINES:-  (not reached)
}"
    echo
    echo "Compile errors (the complete list, so ONE report carries them all):"
    grep -E 'error:' "$KIT/build-noxcode/build.log" 2>/dev/null | head -200 || echo "(no error lines — the build may not have been reached)"
    echo
    echo "Last build lines:"
    tail -60 "$KIT/build-noxcode/build.log" 2>/dev/null || echo "(no build log)"
    echo
    echo "Full install log: $LOG (still on this Mac)"
  } > "$REPORT_FILE"
  echo "report written: $REPORT_FILE"
}

# ── finding the kit ───────────────────────────────────────────────────────────
looks_like_kit() {
  # Absolute paths only (every caller resolves to one). This also refuses the
  # "." a `dirname ""` produces when a find returns nothing — the current
  # directory is not the kit just because it might look like one.
  case "$1" in (/*) ;; (*) return 1 ;; esac
  [ -f "$1/scripts/build-no-xcode.sh" ] && [ -d "$1/Install LUPY.app" ] && [ -f "$1/Mac/Package.swift" ]
}

kit_under() {
  # $1 = a folder that may contain the kit a level or two down → echoes the kit
  local f d
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    d="$(dirname "$(dirname "$f")")"
    if looks_like_kit "$d"; then printf '%s\n' "$d"; return 0; fi
  done <<KITFIND
$(find "$1" -maxdepth 3 -type f -name build-no-xcode.sh -path '*/scripts/build-no-xcode.sh' 2>/dev/null | head -10)
KITFIND
  return 1
}

find_kit() {
  # Search where an unzipped download lives. The newest matching kit wins
  # (an older clone elsewhere must not beat the one just unzipped; a kit
  # from before Install LUPY.app existed can never match at all).
  local root f d m best="" best_m=0
  for root in "$HOME/Downloads" "$HOME/Desktop" "$HOME/Documents"; do
    [ -d "$root" ] || continue
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      d="$(dirname "$(dirname "$f")")"
      looks_like_kit "$d" || continue
      m="$(stat -f %m "$d" 2>/dev/null || stat -c %Y "$d" 2>/dev/null || echo 0)"
      case "$m" in (*[!0-9]*|'') m=0 ;; esac
      if [ -z "$best" ] || [ "$m" -gt "$best_m" ]; then best="$d"; best_m="$m"; fi
    done <<KITFIND
$(find "$root" -maxdepth 4 -type f -name build-no-xcode.sh -path '*/scripts/build-no-xcode.sh' 2>/dev/null | head -20)
KITFIND
  done
  [ -n "$best" ] && printf '%s\n' "$best"
}

choose_kit() {
  # $1 = prompt → echoes the folder the founder points at ("" if cancelled)
  /usr/bin/osascript - "$1" <<'APPLESCRIPT' 2>/dev/null
on run argv
  try
    set f to choose folder with prompt (item 1 of argv)
    return POSIX path of f
  on error
    return ""
  end try
end run
APPLESCRIPT
}

# ── the face ──────────────────────────────────────────────────────────────────
FACE_PID=""
face_start() {
  # Compile LupyProgress.swift (in this bundle) with the tools already proven
  # present, and put its window up. While it compiles (seconds), a refreshing
  # modal says so. Any failure → FACE_PID stays empty and refreshing modals
  # carry the build instead. Never silence.
  local SRC="$APP_BUNDLE/Contents/Resources/LupyProgress.swift" BIN="$STATUS_DIR/LupyProgress"
  FACE_PID=""
  [ -f "$SRC" ] || { echo "face: source missing — modal fallback"; return 0; }
  command -v swiftc >/dev/null 2>&1 || { echo "face: no swiftc — modal fallback"; return 0; }
  echo "face: compiling…"
  ( swiftc -O -o "$BIN" "$SRC" ) &
  local CPID=$! waited=0 M=""
  while kill -0 "$CPID" 2>/dev/null; do
    M="$(modal "Preparing your installer screen…

(a few seconds, first time only — then a window with the six steps stays with you the whole way, and you can minimize it any time)" "Stop" "Stop" 3)"
    if [ "$M" = "Stop" ]; then kill "$CPID" 2>/dev/null; exit 0; fi
    waited=$((waited + 3))
    [ "$waited" -ge 90 ] && break
  done
  wait "$CPID" 2>/dev/null
  if [ ! -x "$BIN" ]; then echo "face: compile failed — modal fallback"; return 0; fi
  "$BIN" "$FACE_STATUS_FILE" "$DONE_FILE" "$CANCEL_FILE" "$HEART_FILE" \
         "$KIT/build-noxcode/build.log" "$ICON" "$RESULT_FILE" "$REPORT_FILE" >/dev/null 2>&1 &
  FACE_PID=$!
  sleep 1
  if ! kill -0 "$FACE_PID" 2>/dev/null; then
    echo "face: died at launch — modal fallback"
    FACE_PID=""
    return 0
  fi
  echo "face: up (pid $FACE_PID)"
}

# ── step 6: prove he's alive ──────────────────────────────────────────────────
VERIFY_OK=1
VERIFY_LINES=""
VERIFY_REASON=""
verify_install() {
  local APP=/Applications/Lupy.app alive=0 waited=0
  VERIFY_OK=1; VERIFY_LINES=""; VERIFY_REASON=""
  chk() { # $1 label · $2 1=ok 0=bad
    if [ "$2" = "1" ]; then
      VERIFY_LINES="${VERIFY_LINES}  ✓ $1
"
    else
      VERIFY_LINES="${VERIFY_LINES}  ✗ $1
"
      VERIFY_OK=0
      [ -n "$VERIFY_REASON" ] || VERIFY_REASON="$1"
    fi
  }
  if [ -d "$APP" ]; then chk "Lupy.app is in Applications" 1; else chk "Lupy.app is in Applications" 0; fi
  if [ -x "$APP/Contents/MacOS/Lupy" ]; then chk "his program is inside, ready to run" 1; else chk "his program is inside, ready to run" 0; fi
  if [ -f "$APP/Contents/Resources/AppIcon.icns" ]; then chk "his face (app icon) is on" 1; else chk "his face (app icon) is on" 0; fi
  if codesign --verify --deep "$APP" >/dev/null 2>&1; then
    VERIFY_LINES="${VERIFY_LINES}  · signature check: OK (ad-hoc, as expected for a home-built app)
"
  else
    VERIFY_LINES="${VERIFY_LINES}  · signature check: complained (not counted as failure on its own)
"
  fi
  while [ $waited -lt 24 ]; do
    if pgrep -x Lupy >/dev/null 2>&1 || pgrep -f "Lupy.app/Contents/MacOS/Lupy" >/dev/null 2>&1; then alive=1; break; fi
    sleep 2; waited=$((waited + 2))
    touch "$HEART_FILE"
    compose_face 98 "waiting for him to appear under your menu bar… (${waited}s)"
  done
  chk "Lupy is running (the pill under your menu bar)" "$alive"
  printf '%s' "$VERIFY_LINES"
  [ "$VERIFY_OK" = "1" ]
}

# ── welcome ───────────────────────────────────────────────────────────────────
CHOICE="$(dialog "LUPY installs himself on this Mac — no Xcode, no Terminal, nothing to type.

You'll watch six steps in a normal Mac window (minimize it any time — the Dock icon shows the %): check this Mac, Apple's free tools, download one small library, compile, install, and finally proof that he's alive. First time takes a few minutes. Then he lives in your Applications and launches by himself: the small dark pill under your menu bar." "Not now,Install LUPY" "Install LUPY")"
[ "$CHOICE" = "Install LUPY" ] || exit 0

# ── steps 1–2: this Mac + Apple's tools ───────────────────────────────────────
step_set 1 '>'
compose_face 2 "finding the kit and checking this Mac…"
echo "self: $0"
echo "resolved bundle: $APP_BUNDLE"
echo "first kit guess (beside this app): $KIT"
case "$APP_BUNDLE" in
  *AppTranslocation*) echo "note: macOS translocated this launch (fresh-download safe corner) — will hunt for the real kit" ;;
esac

if ! looks_like_kit "$KIT"; then
  compose_face 3 "looking for the kit in Downloads, Desktop, Documents…"
  FOUND_KIT="$(find_kit)"
  if [ -n "$FOUND_KIT" ]; then
    KIT="$FOUND_KIT"
    echo "kit found by search: $KIT"
  else
    echo "kit not found by search — asking the founder to point at it"
    CHOICE="$(dialog "macOS runs freshly downloaded apps from a hidden safe corner, so I've lost sight of the Lupy kit folder I arrived in.

Show me the folder you unzipped (look in Downloads) and I'll carry on from there. Nothing was changed." "Not now,Choose the kit folder…" "Choose the kit folder…")"
    [ "$CHOICE" = "Choose the kit folder…" ] || exit 0
    CHOSEN="$(choose_kit "Choose the Lupy kit folder — the one you unzipped, with Mac, LupyCore and scripts inside")"
    CHOSEN="${CHOSEN%/}"
    if [ -n "$CHOSEN" ] && ! looks_like_kit "$CHOSEN"; then
      CHOSEN="$(kit_under "$CHOSEN")"
    fi
    if [ -n "$CHOSEN" ] && looks_like_kit "$CHOSEN"; then
      KIT="$CHOSEN"
      echo "kit chosen by founder: $KIT"
    else
      sorry "That folder isn't the Lupy kit (I look for Mac, LupyCore and scripts inside it).

Try this: download the kit zip again, double-click it, and run Install LUPY from inside the folder that appears — don't move him out of it. Nothing was changed."
    fi
  fi
fi
echo "kit: $KIT"
# He arrived from the founder's own GitHub and the founder just clicked
# "Install LUPY": clear the kit's download-quarantine so macOS never runs
# this kit (or a re-run of this installer) from the hidden corner again.
xattr -dr com.apple.quarantine "$KIT" 2>/dev/null || true

ARCH="$(uname -m)"
if [ "$ARCH" != "arm64" ]; then
  TRANSLATED="$(sysctl -in sysctl.proc_translated 2>/dev/null || echo 0)"
  if [ "$TRANSLATED" != "1" ]; then
    sorry "LUPY needs Apple Silicon (an M-series Mac), and this Mac reports $ARCH.

Nothing was changed. A universal build can be made if you need one — tell Arena."
  fi
fi

OS_MAJOR="$(sw_vers -productVersion 2>/dev/null | cut -d. -f1)"
case "$OS_MAJOR" in (*[!0-9]*|'') OS_MAJOR=0 ;; esac
if [ "$OS_MAJOR" -lt 15 ]; then
  sorry "LUPY needs macOS 15 or newer, and this Mac is on macOS $(sw_vers -productVersion 2>/dev/null).

Update macOS (System Settings → General → Software Update), then double-click me again. Nothing was changed."
fi

if [ ! -w /Applications ]; then
  sorry "I can't write to the Applications folder with this account, so I can't install LUPY like a normal app.

Sign in with an administrator account (or ask whoever manages this Mac), then double-click me again. Nothing was changed."
fi
step_set 1 '+'
compose_face 4 "this Mac is ready"
step_set 2 '>'
compose_face 5 "checking Apple's free tools…"

# Apple's free Command Line Tools carry the compiler (no 8 GB Xcode). The wait
# is shown in a self-refreshing window — the face itself needs the compiler.
if ! xcode-select -p >/dev/null 2>&1 || ! /usr/bin/swift --version >/dev/null 2>&1; then
  CHOICE="$(dialog "One thing first: LUPY is compiled on your Mac with Apple's free Command Line Tools, and they aren't installed yet.

Click “Install Apple's tools” and macOS will offer them (a small download from Apple — not the 8 GB Xcode). Leave everything as it is: when Apple's window finishes, LUPY continues by himself." "Not now,Install Apple's tools" "Install Apple's tools")"
  [ "$CHOICE" = "Install Apple's tools" ] || exit 0
  xcode-select --install >/dev/null 2>&1
  T0=$(date +%s)
  until xcode-select -p >/dev/null 2>&1 && /usr/bin/swift --version >/dev/null 2>&1; do
    compose_face 5 "waiting for Apple's tools… $(elapsed_txt "$T0")"
    M="$(modal "Step 2 of 6 — Apple's free tools

Waiting for Apple's tools to finish installing. Click “Install” in Apple's own window if you can see it. This part is Apple's and can take several minutes; LUPY continues automatically the moment it's ready.

Waited so far: $(elapsed_txt "$T0"). This window refreshes itself — no need to click." "Keep waiting,Not now" "Keep waiting" 15)"
    if [ "$M" = "Not now" ]; then
      sorry "Install stopped while waiting for Apple's tools. Nothing was changed — double-click me again any time."
    fi
    if [ $(( $(date +%s) - T0 )) -ge 1800 ]; then
      sorry "Apple's tools still aren't there after 30 minutes, so I've stopped waiting.

If Apple's window is still working, let it finish — then double-click Install LUPY again and he picks up from here."
    fi
  done
  echo "Apple's tools ready"
fi
step_set 2 '+'
compose_face 6 "Apple's tools ready"

# ── the face goes up, then steps 3–5: the build ───────────────────────────────
face_start
touch "$HEART_FILE"
step_set 3 '>'
compose_face 8 "starting — first build downloads one small library (needs internet)"
echo "== build-no-xcode.sh --install"
BUILD_STARTED=$(date +%s)
LAST_LOG_GROWTH="$BUILD_STARTED"
( cd "$KIT" && LUPY_INSTALL_STATUS_FILE="$BUILD_STATUS_FILE" bash scripts/build-no-xcode.sh --install ) &
BUILD_PID=$!
while kill -0 "$BUILD_PID" 2>/dev/null; do
  touch "$HEART_FILE"
  if cancelled; then
    kill "$BUILD_PID" 2>/dev/null
    break
  fi
  refine_and_compose
  if [ -n "$FACE_PID" ] && ! kill -0 "$FACE_PID" 2>/dev/null; then
    echo "face died mid-build — modal fallback takes over"
    FACE_PID=""
  fi
  if [ -z "$FACE_PID" ]; then
    AIDX="$(active_step)"
    ANAME="Working"; [ "$AIDX" != "0" ] && ANAME="Step $AIDX of 6 — $(step_name "$AIDX")"
    M="$(modal "$ANAME

$LAST_DETAIL

Elapsed: $(elapsed_txt "$BUILD_STARTED"). The first build usually takes 3–6 minutes in total. This window refreshes itself — no need to click anything." "Keep waiting,Cancel install" "Keep waiting" 15)"
    if [ "$M" = "Cancel install" ]; then
      touch "$CANCEL_FILE"
      kill "$BUILD_PID" 2>/dev/null
      break
    fi
  else
    sleep 2
  fi
done
wait "$BUILD_PID" 2>/dev/null
CODE=$?
echo "build exit $CODE after $(elapsed_txt "$BUILD_STARTED")"

# ── the ending: verdict, report, and a final screen that stays ───────────────
RESULT_LINE=""
if cancelled && [ "$CODE" -ne 0 ]; then
  AIDX="$(active_step)"; [ "$AIDX" != "0" ] && step_set "$AIDX" '-'
  RESULT_LINE="CANCELLED"
  write_report "CANCELLED" "the founder stopped it — nothing was changed"
elif [ "$CODE" -ne 0 ]; then
  AIDX="$(active_step)"; [ "$AIDX" = "0" ] && AIDX=4
  step_set "$AIDX" '!'
  compose_face "$OVERALL_PCT" "stopped here — the report has the exact words"
  RESULT_LINE="FAIL|$AIDX|the build stopped (exit $CODE)"
  write_report "FAILED at step $AIDX ($(step_name "$AIDX"))" "build exit $CODE — exact text at the end of this report"
else
  step_set 3 '+'; step_set 4 '+'; step_set 5 '+'
  step_set 6 '>'
  compose_face 98 "checking he's really there — app, icon, and running…"
  if verify_install; then
    step_set 6 '+'
    compose_face 100 "he's alive — look under your menu bar"
    RESULT_LINE="OK"
    write_report "OK — installed and running" ""
  else
    step_set 6 '!'
    compose_face 99 "installed, but a proof check failed"
    RESULT_LINE="FAIL|6|proof check failed: $VERIFY_REASON"
    write_report "FAILED at step 6 (proof)" "$VERIFY_REASON"
  fi
fi

case "$RESULT_LINE" in
  OK) : ;;
  *) cp "$REPORT_FILE" "$HOME/Desktop/Lupy install report.txt" 2>/dev/null || true
     echo "report also copied to Desktop for the founder" ;;
esac

printf '%s' "$RESULT_LINE" > "$RESULT_FILE"
touch "$DONE_FILE"

if [ -n "$FACE_PID" ] && kill -0 "$FACE_PID" 2>/dev/null; then
  # the window is now the final screen (checklist + Save report); wait for
  # the founder to close it (cap 15 min so we never linger forever)
  WAITED=0
  while kill -0 "$FACE_PID" 2>/dev/null && [ "$WAITED" -lt 900 ]; do
    sleep 2; WAITED=$((WAITED + 2))
    touch "$HEART_FILE"
  done
  echo "face closed (waited ${WAITED}s at the final screen)"
  exit 0
fi

# no face: the final word in dialogues, as before
case "$RESULT_LINE" in
  OK)
    dialog "LUPY is installed and running — all six steps proved green.

He's the small dark pill at the top centre of your screen, under the menu bar. Click his typing box to talk to him — or menu bar: Lupy → Demo mode shows his approval card.

From now on he lives in Applications, like any app. You can delete this kit folder." "Done" "Done" >/dev/null
    ;;
  CANCELLED)
    sorry "Install cancelled. LUPY was not installed and nothing was changed — double-click me again any time."
    ;;
  *)
    CHOICE="$(dialog "The install didn't finish — nothing is broken, LUPY just isn't installed yet.

I put a plain-words report on your Desktop: “Lupy install report.txt” — it says exactly which step stopped and why. Send that file (or a screenshot of it) to Arena and a fixed kit comes back." "Not now,Show the report" "Show the report")"
    if [ "$CHOICE" = "Show the report" ]; then
      /usr/bin/open "$HOME/Desktop/Lupy install report.txt" >/dev/null 2>&1 || /usr/bin/open "$REPORT_FILE" >/dev/null 2>&1
    fi
    ;;
esac
exit 0
