.DS_Store
.AppleDouble
.LSOverride

# Secrets and private operational data — never commit
*.p12
*.cer
*.mobileprovision
*.key
*.pem
.env
.env.*
secrets/
lupy-data/
*.lupybackup
private/

# CI verification outputs (scripts/verify-mac-download.sh)
verify-out/
downloaded/

# Python bytecode from the character tooling
__pycache__/
*.pyc
