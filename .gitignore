# Build artefacts
build/
Mac/Lupy.xcodeproj/
Mac/build/
DerivedData/
*.xcuserstate
xcuserdata/
dist/
out/

# Generated only inside the staged, self-contained installer package
Install LUPY.app/Contents/Resources/LupyKit.zip
Install LUPY.app/Contents/Resources/LupyKit.sha256

